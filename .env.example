NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/innogram_db?schema=main"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=innogram_db

AUTH_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001/internal/auth
MONGODB_URI=mongodb://localhost:27017/innogram_auth

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=default_access_secret
JWT_REFRESH_SECRET=default_refresh_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=innogram-media